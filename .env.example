# Booking emails (Resend). Without these, local dev logs bookings; production shows "please call".
RESEND_API_KEY=
BOOKING_TO_EMAIL=
# Must be a sender on a domain verified in Resend, e.g. "Saltbrook bookings <bookings@send.zordev.com>"
BOOKING_FROM_EMAIL=

# Optional
NEXT_PUBLIC_SITE_URL=https://saltbrook.zordev.com
NEXT_PUBLIC_CASE_STUDY_URL=https://www.zordev.com/work/saltbrook-heating-and-air
